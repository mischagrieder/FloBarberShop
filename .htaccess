# ------------------------------------------------------------
# FLO Barber Shop – Basis-Konfiguration für Hostinger (Apache/LiteSpeed)
# ------------------------------------------------------------

# ---------- Kanonische Adresse: immer auf www weiterleiten ----------
# Sorgt dafür, dass https://domain.com und https://www.domain.com
# NICHT zwei verschiedene Versionen zeigen, sondern eine (www).
# Falls du lieber OHNE www willst: diesen Block gegen den www-entfernen-Block tauschen.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} !=localhost [NC]
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]
</IfModule>

# Startseite
DirectoryIndex index.html

# Bei unbekannten Pfaden die Startseite zeigen (Onepager)
ErrorDocument 404 /index.html

# ---------- Gzip-Kompression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ---------- Caching ----------
# HTML NICHT cachen -> Änderungen erscheinen nach dem Deploy sofort.
# Assets (CSS/JS/Bilder) sind über ?v=… versioniert und dürfen lange cachen.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "private, no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml         "access plus 1 month"
  ExpiresByType image/jpeg            "access plus 6 months"
  ExpiresByType image/png             "access plus 6 months"
  ExpiresByType image/webp            "access plus 6 months"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>
